#!/usr/bin/env bash
# Debounced trigger for workspace-summarizer.
# Multiple aerospace events call this; only the last one within 5s fires the summarizer.

ENABLED_FILE="$HOME/.cache/workspace-summarizer/enabled"
LOG="$HOME/.cache/workspace-summarizer/summarizer.log"
mkdir -p "$(dirname "$LOG")"

# Early exit if AI naming is disabled
if [ ! -f "$ENABLED_FILE" ]; then
    echo "[$(date '+%H:%M:%S')] TRIGGER skipped (AI disabled)" >> "$LOG"
    exit 0
fi

PIDFILE="/tmp/workspace-summarizer-trigger.pid"

# Kill any previously scheduled summarizer timer
OLD_PID=$(cat "$PIDFILE" 2>/dev/null)
if [ -n "$OLD_PID" ] && kill "$OLD_PID" 2>/dev/null; then
    echo "[$(date '+%H:%M:%S')] TRIGGER debounce reset (killed pending timer pid=$OLD_PID)" >> "$LOG"
else
    echo "[$(date '+%H:%M:%S')] TRIGGER new (no pending timer)" >> "$LOG"
fi

# Start a new 5-second timer, then run the summarizer
(
    sleep 5
    echo "[$(date '+%H:%M:%S')] TRIGGER debounce elapsed, launching summarizer" >> "$LOG"
    ~/.local/bin/workspace-summarizer
) &
echo $! > "$PIDFILE"
