#!/usr/bin/env bash
# AI workspace summarizer — generates short names for workspaces based on their windows.
# Haiku-only. Gated by enabled file. Tracks cost per session and total.

export PATH="$HOME/.local/bin:$PATH"

CLAUDE=$(command -v claude)
CACHE_DIR="$HOME/.cache/workspace-summarizer"
SUMMARIES_HAIKU="$CACHE_DIR/summaries.haiku"
WINDOWS_FILE="$CACHE_DIR/windows"
HASH_FILE="$CACHE_DIR/windows.hash"
PROMPT_FILE="$HOME/.config/workspace-summarizer/prompt.txt"
LOCK_DIR="/tmp/workspace-summarizer.lock"
LOCK_FILE="$LOCK_DIR"
LOG="$CACHE_DIR/summarizer.log"
ENABLED_FILE="$CACHE_DIR/enabled"
COST_SESSION="$CACHE_DIR/cost.session"
COST_TOTAL="$CACHE_DIR/cost.total"
TOKENS_SESSION="$CACHE_DIR/tokens.session"
TOKENS_TOTAL="$CACHE_DIR/tokens.total"
MANUAL_FILE="$HOME/.config/aerospace/workspace-names"

mkdir -p "$CACHE_DIR"

log() { echo "[$(date '+%H:%M:%S')] $*" >> "$LOG"; }

START_TIME=$(date +%s)
log "--- RUN START ---"

# --- Enabled gate ---
if [ ! -f "$ENABLED_FILE" ]; then
    log "SKIP AI naming disabled"
    log "--- RUN END ---"
    exit 0
fi

# --- Concurrency guard (mkdir is atomic) ---
if ! mkdir "$LOCK_FILE" 2>/dev/null; then
    log "SKIP already running (lock held)"
    exit 0
fi
trap 'rm -rf "$LOCK_FILE"' EXIT

# --- Check claude is available ---
if [ -z "$CLAUDE" ]; then
    log "ERROR claude not found in PATH ($PATH)"
    exit 1
fi
log "Using claude: $CLAUDE"

# --- Read manually-named workspaces to exclude ---
declare -A MANUAL_WS
if [ -f "$MANUAL_FILE" ]; then
    while IFS='|' read -r ws _; do
        [ -n "$ws" ] && MANUAL_WS["$ws"]=1
    done < "$MANUAL_FILE"
fi

# --- Gather current window state (skip manually-named workspaces) ---
log "Gathering windows..."
CURRENT_WINDOWS=""
WS_COUNT=0
WIN_TOTAL=0
for sid in 1 2 3 4 5 6 7 8 9; do
    if [ -n "${MANUAL_WS[$sid]}" ]; then
        log "  ws=$sid skipped (manually named)"
        continue
    fi
    WINS=$(aerospace list-windows --workspace "$sid" --format '%{app-name}|%{window-title}' 2>/dev/null)
    if [ -n "$WINS" ] && echo "$WINS" | grep -q '[^[:space:]]'; then
        CURRENT_WINDOWS+="WORKSPACE $sid:"$'\n'
        CURRENT_WINDOWS+="$WINS"$'\n'
        WS_COUNT=$((WS_COUNT + 1))
        N=$(echo "$WINS" | grep -c '[^[:space:]]')
        WIN_TOTAL=$((WIN_TOTAL + N))
        log "  ws=$sid windows=$N"
    fi
done
log "Found $WIN_TOTAL windows across $WS_COUNT workspaces"

# --- Hash comparison: skip if unchanged ---
CURRENT_HASH=$(echo "$CURRENT_WINDOWS" | shasum -a 256 | cut -d' ' -f1)
PREVIOUS_HASH=$(cat "$HASH_FILE" 2>/dev/null)

if [ "$CURRENT_HASH" = "$PREVIOUS_HASH" ]; then
    ELAPSED=$(( $(date +%s) - START_TIME ))
    log "SKIP windows unchanged (hash=${CURRENT_HASH:0:12}…) [${ELAPSED}s]"
    log "--- RUN END ---"
    exit 0
fi
log "Windows changed (prev=${PREVIOUS_HASH:0:12}… → new=${CURRENT_HASH:0:12}…)"

# --- Build prompt data ---
PREVIOUS_WINDOWS=$(cat "$WINDOWS_FILE" 2>/dev/null)

CURRENT_SUMMARIES_HAIKU=""
if [ -f "$SUMMARIES_HAIKU" ]; then
    while IFS='|' read -r ws summary; do
        [ -n "$ws" ] && CURRENT_SUMMARIES_HAIKU+="Workspace $ws: $summary"$'\n'
    done < "$SUMMARIES_HAIKU"
fi

if [ ! -f "$PROMPT_FILE" ]; then
    log "ERROR prompt file missing: $PROMPT_FILE"
    log "--- RUN END ---"
    exit 1
fi
PROMPT=$(cat "$PROMPT_FILE")
log "Prompt loaded ($(wc -c < "$PROMPT_FILE" | tr -d ' ') bytes)"

MESSAGE="$PROMPT

---
CURRENT WINDOWS:
$CURRENT_WINDOWS
---
YOUR CURRENT SUMMARIES:
${CURRENT_SUMMARIES_HAIKU:-None yet}
---
PREVIOUS WINDOWS (for change detection):
${PREVIOUS_WINDOWS:-First run, no previous data}"

# --- Call Haiku ---
HAIKU_OUT="$CACHE_DIR/response.haiku"

log "Calling Claude (haiku)..."
CLAUDE_START=$(date +%s)

cd "$CACHE_DIR"
echo "$MESSAGE" | "$CLAUDE" -p --model haiku --output-format json > "$HAIKU_OUT" 2>/dev/null
HAIKU_EXIT=$?
HAIKU_DUR=$(( $(date +%s) - CLAUDE_START ))
log "  haiku finished (exit=$HAIKU_EXIT, ${HAIKU_DUR}s)"

# --- Extract result, cost, and tokens from JSON ---
RESPONSE_TEXT=$(jq -r '.result // ""' "$HAIKU_OUT" 2>/dev/null)
RUN_COST=$(jq -r '.total_cost_usd // 0' "$HAIKU_OUT" 2>/dev/null)
RUN_INPUT_TOKENS=$(jq -r '.usage.input_tokens // 0' "$HAIKU_OUT" 2>/dev/null)
RUN_OUTPUT_TOKENS=$(jq -r '.usage.output_tokens // 0' "$HAIKU_OUT" 2>/dev/null)
RUN_CACHE_READ=$(jq -r '.usage.cache_read_input_tokens // 0' "$HAIKU_OUT" 2>/dev/null)
RUN_CACHE_CREATE=$(jq -r '.usage.cache_creation_input_tokens // 0' "$HAIKU_OUT" 2>/dev/null)
RUN_TOKENS=$((RUN_INPUT_TOKENS + RUN_OUTPUT_TOKENS + RUN_CACHE_READ + RUN_CACHE_CREATE))

log "Run cost: \$$RUN_COST, tokens: $RUN_TOKENS (in=$RUN_INPUT_TOKENS out=$RUN_OUTPUT_TOKENS cache_read=$RUN_CACHE_READ cache_create=$RUN_CACHE_CREATE)"

# Accumulate costs and tokens
PREV_COST_SESS=$(cat "$COST_SESSION" 2>/dev/null || echo "0")
PREV_COST_TOTAL=$(cat "$COST_TOTAL" 2>/dev/null || echo "0")
PREV_TOK_SESS=$(cat "$TOKENS_SESSION" 2>/dev/null || echo "0")
PREV_TOK_TOTAL=$(cat "$TOKENS_TOTAL" 2>/dev/null || echo "0")
awk "BEGIN{printf \"%.7f\", $PREV_COST_SESS + $RUN_COST}" > "$COST_SESSION"
awk "BEGIN{printf \"%.7f\", $PREV_COST_TOTAL + $RUN_COST}" > "$COST_TOTAL"
awk "BEGIN{printf \"%d\", $PREV_TOK_SESS + $RUN_TOKENS}" > "$TOKENS_SESSION"
awk "BEGIN{printf \"%d\", $PREV_TOK_TOTAL + $RUN_TOKENS}" > "$TOKENS_TOTAL"
log "Cost session: \$$(cat "$COST_SESSION"), total: \$$(cat "$COST_TOTAL")"
log "Tokens session: $(cat "$TOKENS_SESSION"), total: $(cat "$TOKENS_TOTAL")"

# --- Log raw response ---
log "Haiku raw response:"
echo "$RESPONSE_TEXT" | while IFS= read -r line; do log "  H> $line"; done

# --- Parse output ---
TMPFILE="${SUMMARIES_HAIKU}.tmp"
COUNT=0
> "$TMPFILE"
echo "$RESPONSE_TEXT" | while IFS= read -r line; do
    if [[ "$line" =~ ^([1-9]):\ (.+)$ ]]; then
        echo "${BASH_REMATCH[1]}|${BASH_REMATCH[2]}" >> "$TMPFILE"
    fi
done

COUNT=$(wc -l < "$TMPFILE" | tr -d ' ')
if [ "$COUNT" -gt 0 ]; then
    # Preserve manually-named workspace entries that were already in summaries
    # (they won't be regenerated, so keep old AI entries for them)
    mv "$TMPFILE" "$SUMMARIES_HAIKU"
    log "Parsed haiku: $COUNT summaries"
    while IFS='|' read -r ws summary; do
        log "  haiku ws=$ws → $summary"
    done < "$SUMMARIES_HAIKU"
else
    rm -f "$TMPFILE"
    log "WARNING haiku: no valid lines parsed (kept previous summaries)"
fi

rm -f "$HAIKU_OUT"

# --- Save state ---
echo "$CURRENT_WINDOWS" > "$WINDOWS_FILE"
echo "$CURRENT_HASH" > "$HASH_FILE"

# --- Trigger sketchybar update ---
FOCUSED=$(aerospace list-workspaces --focused 2>/dev/null)
sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$FOCUSED"
sketchybar --trigger ai_naming_changed 2>/dev/null
log "Triggered sketchybar update (focused=$FOCUSED)"

ELAPSED=$(( $(date +%s) - START_TIME ))
log "--- RUN END (${ELAPSED}s total) ---"
