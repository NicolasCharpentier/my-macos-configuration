# ┌─────────────────────────────────────────────────────────┐
# │ skhd config (AZERTY Mac) — left alt as sole modifier    │
# │                                                         │
# │ Replaces cmd+alt Aerospace bindings with lalt-only.     │
# │ Right alt passes through for AZERTY special characters. │
# │                                                         │
# │ Hex key codes for keys that differ AZERTY vs QWERTY:    │
# │   0x12-0x19,0x1A,0x1C = 1-9 (AZERTY: &é"'(-è_ç)       │
# │   0x2F = period/QWERTY (AZERTY: /)                      │
# │   0x18 = equal/QWERTY  (AZERTY: -)                      │
# │   0x2C = slash/QWERTY  (AZERTY: =)                      │
# │   0x2B = comma/QWERTY  (AZERTY: ;)                      │
# │   0x2E = m/QWERTY      (AZERTY: ,)                      │
# │                                                         │
# │ LALT+...                                                │
# │   /           : Toggle tiles H/V                        │
# │   / + MAJ     : Toggle accordion H/V                    │
# │   ZQSD        : Focus gauche/bas/haut/droite             │
# │   ZQSD+MAJ   : Bouger fenetre gauche/bas/haut/droite    │
# │   Fleches     : Pareil que ZQSD (move avec MAJ)         │
# │   -           : Resize -50                              │
# │   = (+)       : Resize +50                              │
# │   - + MAJ     : Resize -50 (opposite direction)         │
# │   = + MAJ     : Resize +50 (opposite direction)         │
# │   1-9         : Aller au workspace N                    │
# │   1-9 + MAJ   : Envoyer fenetre au workspace N          │
# │   TAB         : Workspace back-and-forth                │
# │   TAB + MAJ   : Bouger workspace vers autre monitor     │
# │   N           : Renommer workspace focus (Spotspaces)   │
# │   ;           : Entrer en mode "service"                │
# │   ,           : Entrer en mode "shortcuts"              │
# │                                                         │
# │ LALT+SHIFT+CMD+...                                      │
# │   ZQSD        : Join-with gauche/bas/haut/droite        │
# └─────────────────────────────────────────────────────────┘

# --- Layout toggle ---
# / (AZERTY) → toggle tiles H/V
lalt - 0x2F : aerospace layout tiles horizontal vertical
# / + SHIFT (AZERTY) → toggle accordion H/V
lalt + shift - 0x2F : aerospace layout accordion horizontal vertical

# --- Focus (ZQSD + arrows) ---
lalt - q : aerospace focus left
lalt - s : aerospace focus down
lalt - z : aerospace focus up
lalt - d : aerospace focus right

# --- Move window (ZQSD + arrows) ---
lalt + shift - q : aerospace move left
lalt + shift - s : aerospace move down
lalt + shift - z : aerospace move up
lalt + shift - d : aerospace move right

# --- Resize ---
# - (AZERTY) → resize -50
lalt - 0x18 : aerospace resize smart -50
# + (AZERTY) → resize +50
lalt - 0x2C : aerospace resize smart +50
# - + SHIFT (AZERTY) → resize -50 (opposite direction)
lalt + shift - 0x18 : aerospace resize smart-opposite -50
# + + SHIFT (AZERTY) → resize +50 (opposite direction)
lalt + shift - 0x2C : aerospace resize smart-opposite +50

# --- Switch workspace ---
lalt - 0x12 : aerospace workspace 1
lalt - 0x13 : aerospace workspace 2
lalt - 0x14 : aerospace workspace 3
lalt - 0x15 : aerospace workspace 4
lalt - 0x17 : aerospace workspace 5
lalt - 0x16 : aerospace workspace 6
lalt - 0x1A : aerospace workspace 7
lalt - 0x1C : aerospace workspace 8
lalt - 0x19 : aerospace workspace 9

# --- Move node to workspace + notify SketchyBar ---
lalt + shift - 0x12 : aerospace move-node-to-workspace 1; sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$(aerospace list-workspaces --focused)
lalt + shift - 0x13 : aerospace move-node-to-workspace 2; sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$(aerospace list-workspaces --focused)
lalt + shift - 0x14 : aerospace move-node-to-workspace 3; sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$(aerospace list-workspaces --focused)
lalt + shift - 0x15 : aerospace move-node-to-workspace 4; sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$(aerospace list-workspaces --focused)
lalt + shift - 0x17 : aerospace move-node-to-workspace 5; sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$(aerospace list-workspaces --focused)
lalt + shift - 0x16 : aerospace move-node-to-workspace 6; sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$(aerospace list-workspaces --focused)
lalt + shift - 0x1A : aerospace move-node-to-workspace 7; sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$(aerospace list-workspaces --focused)
lalt + shift - 0x1C : aerospace move-node-to-workspace 8; sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$(aerospace list-workspaces --focused)
lalt + shift - 0x19 : aerospace move-node-to-workspace 9; sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$(aerospace list-workspaces --focused)

# --- Workspace back-and-forth ---
lalt - tab : aerospace workspace-back-and-forth
# Move workspace to other monitor
lalt + shift - tab : aerospace move-workspace-to-monitor --wrap-around next

# --- Rename focused workspace (Spotspaces) ---
lalt - n : /Users/azer/.local/bin/spotspaces-rename-workspace

# --- Enter service mode ---
# ; (AZERTY)
lalt - 0x2B : aerospace mode service; sketchybar --trigger aerospace_mode_change MODE=service

# --- Enter shortcuts mode ---
# , (AZERTY)
lalt - 0x2E : aerospace mode shortcuts; sketchybar --trigger aerospace_mode_change MODE=shortcuts

# --- Join with (always available, no mode needed) ---
lalt + shift + cmd - q : aerospace join-with left
lalt + shift + cmd - s : aerospace join-with down
lalt + shift + cmd - z : aerospace join-with up
lalt + shift + cmd - d : aerospace join-with right
