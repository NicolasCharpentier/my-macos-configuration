#!/usr/bin/env bash

# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see FelixKratz's dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

sketchybar --bar position=top \
                 height=37 \
                 blur_radius=30 \
                 color=0x00000000 \
                 sticky=off \
                 padding_left=10 \
                 padding_right=10

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_mode_change
sketchybar --add event ai_naming_changed

# SERVICE mode label (hidden by default, shown when entering service mode)
sketchybar --add item service.label left \
    --set service.label \
        drawing=off \
        background.drawing=on \
        background.color=0xffe1a860 \
        background.corner_radius=5 \
        background.height=25 \
        icon.drawing=off \
        label="SERVICE" \
        label.font="Hack Nerd Font:Bold:14.0" \
        label.color=0xff1e1e2e \
        label.padding_left=10 \
        label.padding_right=10

# Mode watcher: toggles SERVICE label vs unified view
sketchybar --add item mode.watcher left \
    --subscribe mode.watcher aerospace_mode_change \
    --set mode.watcher \
        drawing=off \
        script="$PLUGIN_DIR/mode.sh"

##### Unified monitor+workspace view #####

MONITOR_IDS=($(aerospace list-monitors --format '%{monitor-id}'))

# Get display arrangement IDs from sketchybar
DISPLAY_IDS=($(sketchybar --query displays 2>/dev/null \
    | python3 -c "import json,sys; [print(d['arrangement-id']) for d in json.load(sys.stdin)]"))

# Per-display item sets: each display gets its own copy so monitor name
# styling can differ (gold=focused+local, white=local, plain=remote)
for did in "${DISPLAY_IDS[@]}"; do
    UFIRST=true
    for mid in "${MONITOR_IDS[@]}"; do
        MNAME=$(aerospace list-monitors --format '%{monitor-id}|%{monitor-name}' \
            | grep "^${mid}|" | cut -d'|' -f2)

        # Separator between monitor blocks (not before the first)
        if [ "$UFIRST" = true ]; then
            UFIRST=false
        else
            sketchybar --add item unified.d$did.sep.$mid left \
                --set unified.d$did.sep.$mid \
                    display=$did \
                    icon="|" \
                    icon.font="Hack Nerd Font:Bold:18.0" \
                    icon.color=0xb0ffffff \
                    icon.padding_left=4 \
                    icon.padding_right=4 \
                    label.drawing=off \
                    padding_left=0 \
                    padding_right=0 \
                    background.drawing=off
        fi

        # Monitor name label
        sketchybar --add item unified.d$did.mon.$mid left \
            --set unified.d$did.mon.$mid \
                display=$did \
                background.corner_radius=5 \
                background.height=25 \
                background.drawing=off \
                icon.drawing=off \
                label="${MNAME:0:5}" \
                label.font="Hack Nerd Font:Bold:14.0" \
                label.padding_left=8 \
                label.padding_right=8 \
                padding_left=0 \
                padding_right=0

        # Workspace slots (1-9) for this monitor on this display, initially hidden
        for sid in 1 2 3 4 5 6 7 8 9; do
            sketchybar --add item unified.d$did.ws.$mid.$sid left \
                --subscribe unified.d$did.ws.$mid.$sid mouse.entered mouse.exited mouse.exited.global \
                --set unified.d$did.ws.$mid.$sid \
                    display=$did \
                    background.color=0xffe1a860 \
                    background.corner_radius=5 \
                    background.height=25 \
                    background.drawing=off \
                    background.border_color=0xffffffff \
                    background.border_width=1 \
                    icon="$sid" \
                    icon.font="Hack Nerd Font:Bold:14.0" \
                    icon.padding_left=7 \
                    icon.padding_right=2 \
                    label.drawing=on \
                    label.font="sketchybar-app-font:Regular:14.0" \
                    label.padding_left=2 \
                    label.padding_right=7 \
                    padding_left=2 \
                    padding_right=2 \
                    drawing=off \
                    popup.background.color=0xe0202020 \
                    popup.background.corner_radius=8 \
                    popup.background.border_color=0xffffffff \
                    popup.background.border_width=1 \
                    click_script="$PLUGIN_DIR/rename_workspace.sh $sid" \
                    script="$PLUGIN_DIR/unified_popup.sh $sid"

        done
    done
done

# Controller: hidden item that triggers unified view updates
sketchybar --add item unified.controller left \
    --subscribe unified.controller aerospace_workspace_change \
    --set unified.controller \
        drawing=off \
        script="$PLUGIN_DIR/unified.sh"

##### System Stats (stats_provider daemon) #####
killall stats_provider 2>/dev/null
stats_provider --all --interval 5 &

sketchybar --add event system_stats

##### Right Items #####
sketchybar --add item clock.time right \
           --set clock.time \
               update_freq=1 \
               icon.drawing=off \
               label.font="Hack Nerd Font:Bold:14.0" \
               label.color=0xffffffff \
               script="$PLUGIN_DIR/clock.sh" \
           --add item clock.date right \
           --set clock.date \
               update_freq=60 \
               icon.drawing=off \
               label.font="Hack Nerd Font:Bold:14.0" \
               label.color=0xffffffff \
               script="$PLUGIN_DIR/date.sh" \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           --add item ram.stats right \
           --set ram.stats \
               icon.drawing=off \
               label="RAM …" \
               popup.background.color=0xe0202020 \
               popup.background.corner_radius=8 \
               popup.background.border_color=0xffffffff \
               popup.background.border_width=1 \
               script="$PLUGIN_DIR/stats.sh" \
           --subscribe ram.stats mouse.entered mouse.exited mouse.exited.global \
           --add item cpu.stats right \
           --set cpu.stats \
               icon.drawing=off \
               label="CPU …" \
               popup.background.color=0xe0202020 \
               popup.background.corner_radius=8 \
               popup.background.border_color=0xffffffff \
               popup.background.border_width=1 \
               script="$PLUGIN_DIR/stats.sh" \
           --subscribe cpu.stats system_stats mouse.entered mouse.exited mouse.exited.global \
           --add item mic right \
           --set mic \
               icon="󰍬" \
               icon.font="Hack Nerd Font:Bold:17.0" \
               label.drawing=off \
               update_freq=5 \
               script="$PLUGIN_DIR/mic.sh" \
           --subscribe mic mouse.clicked

# AI naming control panel (hidden when globally disabled)
if [ ! -f "$HOME/.config/workspace-summarizer/disabled" ]; then
    sketchybar --add item ai.naming right \
               --set ai.naming \
                   icon="󰯃" \
                   icon.font="Hack Nerd Font:Bold:17.0" \
                   icon.color=0xffffb3b3 \
                   label.drawing=off \
                   popup.background.color=0xe0202020 \
                   popup.background.corner_radius=8 \
                   popup.background.border_color=0xffffffff \
                   popup.background.border_width=1 \
                   script="$PLUGIN_DIR/ai_naming.sh" \
               --subscribe ai.naming mouse.clicked ai_naming_changed
fi

##### Auto-update on monitor change #####
sketchybar --add item display_watcher right \
           --set display_watcher \
               drawing=off \
               script="$PLUGIN_DIR/display_change.sh" \
           --subscribe display_watcher display_change system_woke

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
