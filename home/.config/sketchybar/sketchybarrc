#!/usr/bin/env bash

# Add a command that opens up a new workspace at available number

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
sketchybar --bar position=top \
                 height=45 \
                 blur_radius=0 \
                 color=0xffd5d1cb \
                 shadow=off \
                 sticky=off \
                 padding_left=15 \
                 padding_right=15

##### Changing Defaults #####
default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color=0xff3a3630
  label.color=0xff3a3630
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_mode_change
sketchybar --add event ai_naming_changed

# SERVICE mode label (hidden by default, shown when entering service mode)
sketchybar --add item service.label left \
    --set service.label \
        drawing=off \
        background.drawing=on \
        background.color=0xffe1a860 \
        background.corner_radius=5 \
        background.height=25 \
        icon.drawing=off \
        label="SERVICE" \
        label.font="Hack Nerd Font:Bold:14.0" \
        label.color=0xffffffff \
        label.padding_left=10 \
        label.padding_right=10

# Mode watcher: toggles SERVICE label vs unified view
sketchybar --add item mode.watcher left \
    --subscribe mode.watcher aerospace_mode_change \
    --set mode.watcher \
        drawing=off \
        script="$PLUGIN_DIR/mode.sh"

##### Unified monitor+workspace view #####

MONITOR_IDS=($(aerospace list-monitors --format '%{monitor-id}'))

# Get display arrangement IDs from sketchybar
DISPLAY_IDS=($(sketchybar --query displays 2>/dev/null \
    | python3 -c "import json,sys; [print(d['arrangement-id']) for d in json.load(sys.stdin)]"))

UFIRST_DISPLAY=()
for did in "${DISPLAY_IDS[@]}"; do
    UFIRST=true
    for mid in "${MONITOR_IDS[@]}"; do
        MNAME=$(aerospace list-monitors --format '%{monitor-id}|%{monitor-name}' \
            | grep "^${mid}|" | cut -d'|' -f2)

        # Spacer between monitor groups (not before first)
        if [ "$UFIRST" = true ]; then
            UFIRST=false
        else
            sketchybar --add item unified.d$did.gap.$mid left \
                --set unified.d$did.gap.$mid \
                    display=$did \
                    icon.drawing=off \
                    label.drawing=off \
                    background.drawing=off \
                    padding_left=8 \
                    padding_right=0 \
                    width=6
        fi

        # Monitor name label (before workspace slots)
        sketchybar --add item unified.d$did.mon.$mid left \
            --set unified.d$did.mon.$mid \
                display=$did \
                background.drawing=off \
                icon.drawing=off \
                label="${MNAME:0:5}" \
                label.font="Hack Nerd Font:Bold:13.0" \
                label.color=0xff9a958d \
                label.padding_left=6 \
                label.padding_right=16 \
                padding_left=0 \
                padding_right=0

        # Workspace slots (1-9): badge + content items + bracket 
        for sid in 1 2 3 4 5 6 7 8 9; do
            # Badge item: just the workspace number (carries the gold badge)
            sketchybar --add item unified.d$did.ws.$mid.$sid.badge left \
                --set unified.d$did.ws.$mid.$sid.badge \
                    display=$did \
                    drawing=off \
                    background.drawing=off \
                    icon="$sid" \
                    icon.font="Hack Nerd Font:Regular:16.0" \
                    icon.color=0xff9a958d \
                    icon.padding_left=6 \
                    icon.padding_right=7 \
                    icon.background.drawing=off \
                    icon.background.color=0xffe1a860 \
                    icon.background.height=22 \
                    icon.background.corner_radius=6 \
                    label.drawing=off \
                    padding_left=11 \
                    padding_right=0

            # Content item: workspace name + app icons
            sketchybar --add item unified.d$did.ws.$mid.$sid left \
                --subscribe unified.d$did.ws.$mid.$sid mouse.entered mouse.exited mouse.exited.global \
                --set unified.d$did.ws.$mid.$sid \
                    display=$did \
                    drawing=off \
                    background.drawing=off \
                    icon="" \
                    icon.font="Hack Nerd Font:Bold:13.0" \
                    icon.color=0xff9a958d \
                    icon.padding_left=2 \
                    icon.padding_right=4 \
                    label.drawing=on \
                    label.font="sketchybar-app-font:Regular:14.0" \
                    label.color=0xff9a958d \
                    label.padding_left=2 \
                    label.padding_right=4 \
                    padding_left=0 \
                    padding_right=11 \
                    popup.background.color=0xf0f5f2ef \
                    popup.background.corner_radius=8 \
                    popup.background.border_color=0xffd0ccc6 \
                    popup.background.border_width=1 \
                    click_script="$PLUGIN_DIR/rename_workspace.sh $sid" \
                    script="$PLUGIN_DIR/unified_popup.sh $sid"

            # Bracket: unified tab background behind badge + content
            sketchybar --add bracket unified.d$did.ws.$mid.$sid.tab \
                    unified.d$did.ws.$mid.$sid.badge \
                    unified.d$did.ws.$mid.$sid \
                --set unified.d$did.ws.$mid.$sid.tab \
                    background.drawing=off \
                    background.color=0xffe0dcd6 \
                    background.corner_radius=6 \
                    background.height=28 \
                    background.border_width=0 \
                    background.padding_left=0 \
                    background.padding_right=0

            # Gap spacer after tab (not part of any bracket)
            sketchybar --add item unified.d$did.ws.$mid.$sid.spacer left \
                --set unified.d$did.ws.$mid.$sid.spacer \
                    display=$did \
                    drawing=off \
                    icon.drawing=off \
                    label.drawing=off \
                    background.drawing=off \
                    padding_left=0 \
                    padding_right=0 \
                    width=4
        done
    done
done

# Controller: hidden item that triggers unified view updates
sketchybar --add item unified.controller left \
    --subscribe unified.controller aerospace_workspace_change \
    --set unified.controller \
        drawing=off \
        script="$PLUGIN_DIR/unified.sh"

##### System Stats (stats_provider daemon) #####
killall stats_provider 2>/dev/null
stats_provider --all --interval 5 &

sketchybar --add event system_stats

##### Right Items #####
sketchybar --add item clock.time right \
           --set clock.time \
               update_freq=1 \
               icon.drawing=off \
               label.font="Hack Nerd Font:Bold:14.0" \
               label.color=0xff3a3630 \
               script="$PLUGIN_DIR/clock.sh" \
           --add item clock.date right \
           --set clock.date \
               update_freq=60 \
               icon.drawing=off \
               label.font="Hack Nerd Font:Bold:14.0" \
               label.color=0xff3a3630 \
               script="$PLUGIN_DIR/date.sh" \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           --add item ram.stats right \
           --set ram.stats \
               icon.drawing=off \
               label="RAM …" \
               popup.background.color=0xf0f5f2ef \
               popup.background.corner_radius=8 \
               popup.background.border_color=0xffd0ccc6 \
               popup.background.border_width=1 \
               script="$PLUGIN_DIR/stats.sh" \
           --subscribe ram.stats mouse.entered mouse.exited mouse.exited.global \
           --add item cpu.stats right \
           --set cpu.stats \
               icon.drawing=off \
               label="CPU …" \
               popup.background.color=0xf0f5f2ef \
               popup.background.corner_radius=8 \
               popup.background.border_color=0xffd0ccc6 \
               popup.background.border_width=1 \
               script="$PLUGIN_DIR/stats.sh" \
           --subscribe cpu.stats system_stats mouse.entered mouse.exited mouse.exited.global \
           --add item mic right \
           --set mic \
               icon="󰍬" \
               icon.font="Hack Nerd Font:Bold:17.0" \
               label.drawing=off \
               update_freq=5 \
               script="$PLUGIN_DIR/mic.sh" \
           --subscribe mic mouse.clicked

# AI naming control panel (hidden when globally disabled)
if [ ! -f "$HOME/.config/workspace-summarizer/disabled" ]; then
    sketchybar --add item ai.naming right \
               --set ai.naming \
                   icon="󰯃" \
                   icon.font="Hack Nerd Font:Bold:17.0" \
                   icon.color=0xffe1a860 \
                   label.drawing=off \
                   popup.background.color=0xf0f5f2ef \
                   popup.background.corner_radius=8 \
                   popup.background.border_color=0xffd0ccc6 \
                   popup.background.border_width=1 \
                   script="$PLUGIN_DIR/ai_naming.sh" \
               --subscribe ai.naming mouse.clicked ai_naming_changed
fi

##### Auto-update on monitor change #####
sketchybar --add item display_watcher right \
           --set display_watcher \
               drawing=off \
               script="$PLUGIN_DIR/display_change.sh" \
           --subscribe display_watcher display_change system_woke

# Set solid wallpaper for visual continuity with raised tabs
"$PLUGIN_DIR/set_wallpaper.sh" f8f7f5 &

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
